<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wordcraftpdf</groupId>
        <artifactId>wordcraftpdf-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>wordcraftpdf</artifactId>
    <name>WordCraftPdf</name>
    <description>Process-isolated document to PDF conversion with the WordCraft engine</description>

    <properties>
        <!--
          Folder whose content is added to the JAR as-is: scripts/pack-maven.sh stages the native
          worker there (native/<platform>/wcpdf_worker) together with its licenses. A missing
          folder is skipped, so a plain `mvn package` builds the API-only JAR.
        -->
        <wcpdf.native.dir>${project.basedir}/native-bundle</wcpdf.native.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>com/wordcraftpdf/wordcraftpdf.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>${wcpdf.native.dir}</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Lets the integration tests find the fixtures and output/bin/wcpdf_worker. -->
                        <wcpdf.project.root>${project.basedir}/../..</wcpdf.project.root>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>com.wordcraftpdf</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
