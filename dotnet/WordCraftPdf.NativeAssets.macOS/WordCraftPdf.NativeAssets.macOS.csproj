<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Packaging-only project: no code, just the native worker -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- NuGet metadata -->
    <PackageId>WordCraftPdf.NativeAssets.macOS</PackageId>
    <Version>0.1.0</Version>
    <Authors>mapo80</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mapo80/wordcraft-to-pdf</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mapo80/wordcraft-to-pdf</PackageProjectUrl>
    <Description>Native macOS worker for WordCraftPdf: wcpdf_worker, the out-of-process WordCraft (pure Rust) conversion engine, for Apple Silicon (osx-arm64) and Intel (osx-x64). No system dependencies.</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageTags>pdf;conversion;docx;wordcraft;native;macos</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
  </PropertyGroup>

  <!-- Input directories: scripts/build.sh output folders, each with bin/wcpdf_worker and licenses/
       (override via -p:NativeDir_arm64=path/ -p:NativeDir_x64=path/; scripts/pack-nuget.sh does) -->
  <PropertyGroup>
    <NativeDir_arm64 Condition="'$(NativeDir_arm64)' == ''">../../output-macos-arm64/</NativeDir_arm64>
    <NativeDir_x64 Condition="'$(NativeDir_x64)' == ''">../../output-macos-x64/</NativeDir_x64>
    <NativeDir_arm64 Condition="!HasTrailingSlash('$(NativeDir_arm64)')">$(NativeDir_arm64)/</NativeDir_arm64>
    <NativeDir_x64 Condition="!HasTrailingSlash('$(NativeDir_x64)')">$(NativeDir_x64)/</NativeDir_x64>
    <_WcpdfLicenses Condition="Exists('$(NativeDir_arm64)licenses')">$(NativeDir_arm64)licenses/</_WcpdfLicenses>
    <_WcpdfLicenses Condition="'$(_WcpdfLicenses)' == '' and Exists('$(NativeDir_x64)licenses')">$(NativeDir_x64)licenses/</_WcpdfLicenses>
  </PropertyGroup>

  <!-- Standard NuGet native layout: the SDK copies runtimes/<rid>/native/ to the output
       (flattened into the app directory for RID-specific builds). -->
  <ItemGroup Condition="Exists('$(NativeDir_arm64)bin/wcpdf_worker')">
    <None Include="$(NativeDir_arm64)bin/wcpdf_worker" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <_WcpdfPackedWorker Include="osx-arm64" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(NativeDir_x64)bin/wcpdf_worker')">
    <None Include="$(NativeDir_x64)bin/wcpdf_worker" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <_WcpdfPackedWorker Include="osx-x64" />
  </ItemGroup>

  <!-- Third-party licenses of the engine and bundled fonts (package root, not copied to apps) -->
  <ItemGroup Condition="'$(_WcpdfLicenses)' != ''">
    <None Include="$(_WcpdfLicenses)**" Pack="true" PackagePath="licenses/" />
  </ItemGroup>

  <!-- Ship MSBuild .targets so consumers get the execute bit restored -->
  <ItemGroup>
    <None Include="build/WordCraftPdf.NativeAssets.macOS.targets" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive/WordCraftPdf.NativeAssets.macOS.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="_WcpdfRequireWorker" BeforeTargets="GenerateNuspec">
    <Error Condition="'@(_WcpdfPackedWorker)' == ''"
           Text="No wcpdf_worker found in '$(NativeDir_arm64)bin/' or '$(NativeDir_x64)bin/'. Build it with scripts/build.sh, then pack with scripts/pack-nuget.sh." />
    <Message Importance="high" Text="WordCraftPdf.NativeAssets.macOS: packing @(_WcpdfPackedWorker->'%(Identity)', ', ')" />
  </Target>

</Project>
