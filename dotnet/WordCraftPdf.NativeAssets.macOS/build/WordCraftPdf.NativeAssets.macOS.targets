<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    NuGet copies runtimes/<rid>/native/wcpdf_worker to the output (runtimes/<rid>/native/ for
    portable apps, the application directory for RID-specific builds) but does not preserve the
    file's execute bit. Restore it after Build and Publish. (WordCraftPdf also restores it at
    run time when it can, e.g. when the output folder is copied elsewhere afterwards.)
  -->
  <Target Name="_WordCraftPdfSetExecuteBit_macOS" AfterTargets="Build"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_WcpdfWorkerOut_macOS Include="$(OutDir)runtimes/osx-arm64/native/wcpdf_worker;$(OutDir)runtimes/osx-x64/native/wcpdf_worker;$(OutDir)wcpdf_worker" />
    </ItemGroup>
    <Exec Command="chmod a+x &quot;%(_WcpdfWorkerOut_macOS.FullPath)&quot;"
          Condition="Exists('%(_WcpdfWorkerOut_macOS.FullPath)')"
          ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

  <Target Name="_WordCraftPdfSetExecuteBitOnPublish_macOS" AfterTargets="Publish"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_WcpdfWorkerPub_macOS Include="$(PublishDir)runtimes/osx-arm64/native/wcpdf_worker;$(PublishDir)runtimes/osx-x64/native/wcpdf_worker;$(PublishDir)wcpdf_worker" />
    </ItemGroup>
    <Exec Command="chmod a+x &quot;%(_WcpdfWorkerPub_macOS.FullPath)&quot;"
          Condition="Exists('%(_WcpdfWorkerPub_macOS.FullPath)')"
          ContinueOnError="true" StandardOutputImportance="low" />
  </Target>
</Project>
